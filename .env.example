# Optional API keys for live model runs.
#
# Copy this file to .env and fill only the providers you plan to run.
# The live LLM runner also accepts the same names as process environment
# variables. Do not commit .env.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Anthropic/Claude provider key. The current runner expects CLAUDE_API_KEY.
CLAUDE_API_KEY=""
