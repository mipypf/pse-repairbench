{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pse-repairbench.local/schemas/repair_output.schema.json",
  "title": "PSE-RepairBench Canonical Repair Output v0.1",
  "type": "object",
  "required": ["diagnosis", "repair_actions", "rationale"],
  "properties": {
    "diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "repair_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "https://pse-repairbench.local/schemas/repair_action.schema.json"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
